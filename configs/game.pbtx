# Perfetto trace config for mobile-game performance triage.
#
# Must stay parseable by older on-device perfetto binaries (a Galaxy S24 on
# Android 15 ships Perfetto v46): sys_stats thermal_period_ms / gpufreq_period_ms
# are NOT used for that reason. GPU clock and thermal come from the sidecar
# sampler instead (see docs/RECORDING.md).
#
# `gpa record` rewrites duration_ms from --duration.

buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 8192
  fill_policy: RING_BUFFER
}

duration_ms: 30000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 10000

# Frame pacing and jank (Android 12+).
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

# Scheduling, CPU frequency/idle, and kernel thermal/GPU events where available.
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      compact_sched { enabled: true }
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/suspend_resume"
      # Missing on some kernels (e.g. S24); harmless when absent.
      ftrace_events: "power/gpu_frequency"
      ftrace_events: "thermal/thermal_temperature"
      ftrace_events: "thermal/cdev_update"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_apps: "*"
    }
  }
}

# Process and thread names.
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

# CPU topology: per-CPU available frequencies (used to rank clusters).
data_sources {
  config {
    name: "linux.system_info"
    target_buffer: 1
  }
}
